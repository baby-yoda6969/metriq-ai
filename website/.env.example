GEMINI_API_KEY=your_gemini_api_key_here
# Optional comma-separated fallback keys, tried in order whenever the
# current key hits a quota/rate-limit error (see server/index.js's
# callGemini). Handy on the free tier's low daily request cap.
GEMINI_API_KEY_BACKUPS=
GEMINI_MODEL=gemini-2.5-flash

# Website API port. This is independent from the Android backend on 3000.
WEBSITE_API_PORT=8787
